            {
              "type": "text",
              "id": "Y91sjO",
              "name": "Sanskrit Verse",
              "fill": "$ash",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "માતૃદેવો ભવ । પિતૃદેવો ભવ ।\nઆચાર્યદેવો ભવ । અતિથિદેવો ભવ ।\nયાન્યનવદ્યાનિ કર્માણિ તાનિ સેવિતવ્યાનિ । નો ઇતરાણિ ।",
              "lineHeight": 1.55,
              "textAlign": "center",
              "fontFamily": "$font-gu-body",
              "fontSize": 19,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "ga6c4",
              "name": "Translation",
              "fill": "$ash-muted",
              "content": "માતાને દેવ માનો. પિતાને દેવ માનો.\nગુરુને દેવ માનો. અતિથિને દેવ માનો.\nજે કર્મો નિર્દોષ છે, તે જ અપનાવો.",
              "lineHeight": 1.55,
              "textAlign": "center",
              "fontFamily": "$font-gu-body",
              "fontSize": 16,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "fApiP",
              "name": "Not the others",
              "fill": "$kumkum",
              "content": "બાકીનાં નહીં.",
              "fontFamily": "$font-gu-body",
              "fontSize": 21,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "h6riW",
              "name": "Citation",
              "fill": "$ash-muted",
              "content": "તૈત્તિરીય ઉપનિષદ  ૧.૧૧.૨",
              "fontFamily": "$font-gu-label",
              "fontSize": 12,
              "fontWeight": "500"
            }
          ]
        },
        {
          "type": "frame",
          "id": "zRNyz",
          "name": "Blurb",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 12,
          "children": [
            {
              "type": "text",
              "id": "Vas2c",
              "name": "Paragraph 1",
              "fill": "$ash",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "સુરતના પાલ ગામની મોટી ફળીમાં કોઈ તેમને સાચા નામથી બોલાવતું નહોતું. ફળી તેમને શંભુ કહેતી, જે શિવનું જ એક નામ છે. પ્રામાણિક. શ્રદ્ધાળુ. દરેક લગ્ન અને દરેક અંતિમવિધિ વખતે સમાજ સૌથી પહેલાં તેમને જ બોલાવતો.",
              "lineHeight": 1.55,
              "fontFamily": "$font-gu-body",
              "fontSize": 15.5,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "phAZ0",
              "name": "Paragraph 2",
              "fill": "$kumkum",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "તેમનો પરિવાર એક જુદા જ માણસને ઓળખતો હતો.",
              "lineHeight": 1.55,
              "fontFamily": "$font-gu-body",
              "fontSize": 18,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "zIyGr",
              "name": "Paragraph 3",
              "fill": "$ash",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "આ સત્ય કથામાં તેમનો દીકરો બંધ દરવાજા પાછળની વાત કહે છે, જે ફળીએ ક્યારેય જોઈ નહોતી. દારૂની ટેવ બદલ પલંગ સાથે બાંધીને મારવામાં આવેલા દાદા. નવ જણની રસોઈ કરતી, ઘરનો ખર્ચ ઉપાડતી, અને પોતાનો મત રાખવા બદલ માર ખાતી મા. પોતાના જ પિતાના ડર હેઠળ મોટાં થયેલાં બે બાળકો. અને એક દીકરો, જેનાં લગ્ન એક જ સવાલ પરથી નક્કી થયાં: સમાજ શું કહેશે?",
              "lineHeight": 1.55,
              "fontFamily": "$font-gu-body",
              "fontSize": 15.5,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "JC9j2",
              "name": "Paragraph 4",
              "fill": "$ash",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "જે શાસ્ત્રો જાણવાનો પિતાને આટલો ગર્વ હતો, ફેરિન પટેલ એ જ શાસ્ત્રોના ત્રાજવે પિતાને તોલે છે. પરિણામ છે એક દીકરાનો હિસાબ, અને આબરૂદાર દરવાજા પાછળ જીવતા દરેક પરિવાર માટે એક અરીસો.",
              "lineHeight": 1.55,
              "fontFamily": "$font-gu-body",
              "fontSize": 15.5,
              "fontWeight": "normal"
            }
          ]
        },
